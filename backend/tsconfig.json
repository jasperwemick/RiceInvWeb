{
    "compilerOptions": {
        "outDir": "./dist",
        "rootDir": ".",
        "module": "esnext",
        "moduleResolution": "bundler",
        "target": "es2023",
        "esModuleInterop": true
    },
    "include": ["server.ts", "controllers/*", "middleware/*", "models/*", "routers/*", "types/*"],
    "exclude": ["node_modules", "build", "**/*.spec.ts"]
}